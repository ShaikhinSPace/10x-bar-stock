# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reports downloaded from /api/report — real stock data, not source
10x-bar-*.pdf
10x-bar-*.xlsx

# database dumps at the repo root — real stock data and password hashes.
# Anchored with a leading slash so src/lib/seed-items.json stays tracked.
/items.json
/moves.json
/users.json
/categories.json
/item_tags.json
